<?xml version="1.0" encoding="utf-8"?>
<!--
  WLO-0058 — Android 11 and lower full-backup policy.

  WLO data is deliberately portable only through the user-controlled SAF
  export/backup flow. Keep this exhaustive: a newly used Android storage
  domain must not silently become an OS-managed cloud or transfer channel.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
