<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      D4 / R-S13: INTERNET is declared ONLY here (:app) — no library module may
      declare it (checkArchitecture bans it in every module manifest and asserts
      its presence in :app's merged manifest). Every packet flows through
      :core:network's NetworkDispatcher: consent-gated (or the R-C4 allowance),
      hash-chained-receipted, visible in the wlo://debug/egress monitor.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- BiometricPrompt gate (F13 app lock): required for BiometricManager.canAuthenticate. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The weigh-in reminder (F06 §4, WLO-0040): runtime-asked when the user arms it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WloApplication"
        android:label="WLO"
        android:icon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wlo">

        <!--
          R-D1: the app is dark-first; Theme.Wlo (values/) is the dark canonical
          theme for both day and night. Light is a future, derived theme.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              wlo:// deep links (IA.md §3 registry): scheme only, no host —
              every surface routes through WloDeepLinks.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wlo" />
            </intent-filter>
        </activity>
    </application>
</manifest>
