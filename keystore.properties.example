# Copy to keystore.properties (git-ignored) and fill in — WLO-0029.
# ONE keystore serves both the alpha and release channels: changing the
# signing identity forces an uninstall on dogfood devices (data loss).
# Generate: keytool -genkeypair -v -keystore wlo-release.keystore -alias wlo \
#   -keyalg RSA -keysize 4096 -validity 10950
# CI instead injects the same values via WLO_SIGNING_* env vars from Actions
# secrets (keystore itself as base64 in WLO_SIGNING_KEYSTORE_BASE64).
storeFile=wlo-release.keystore
storePassword=CHANGE_ME
keyAlias=wlo
keyPassword=CHANGE_ME
